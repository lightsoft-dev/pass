{
  "name": "pass-mobile",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check:icon": "node scripts/verify-app-icon.mjs",
    "eas-build-pre-install": "npm run check:icon",
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs && node scripts/build-terminal-document.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/conversation/richText.test.ts src/conversation/terminalConversation.test.ts src/demo/demoData.test.ts src/protocol/protocol.test.ts src/services/accountService.test.ts src/services/appleAuthorizationService.test.ts src/services/appleDeletionFallback.test.ts src/services/deviceCredentialService.test.ts src/services/feedbackService.test.ts src/services/identitySession.test.ts src/services/relayURL.test.ts src/services/remoteClient.test.ts src/state/reducer.test.ts"
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@xterm/xterm": "^6.0.0",
    "expo": "~57.0.12",
    "expo-apple-authentication": "~57.0.1",
    "expo-camera": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.11",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
