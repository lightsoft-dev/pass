{
  "expo": {
    "name": "Pass Remote",
    "slug": "pass-mobile",
    "owner": "lightsoft-crew",
    "version": "0.1.1",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "passremote",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "dev.lightsoft.passmobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "dev.lightsoft.passmobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pass Remote to scan a one-time pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-system-ui",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11130f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3daf1488-aa08-4d79-b939-4a06b9be9759"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3daf1488-aa08-4d79-b939-4a06b9be9759"
    }
  }
}
