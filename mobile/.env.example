# Public Google OAuth client identifiers. These are embedded in the app; never add a client secret.
# The Web client id is also the Relay OIDC audience. Android authorization is registered against
# dev.lightsoft.passmobile and each signing-certificate SHA-1 in Google Cloud. The iOS value must
# be a dedicated iOS-type Google OAuth client registered for the dev.lightsoft.passmobile bundle
# identifier. Confirm each EAS environment separately before building.
EXPO_PUBLIC_PASS_GOOGLE_WEB_CLIENT_ID=181273138649-6t8qq9nubb5be8ckob8jnme6ptlk705q.apps.googleusercontent.com
EXPO_PUBLIC_PASS_GOOGLE_IOS_CLIENT_ID=181273138649-mm51fq7dmobrp9eiig1fghie9nm0j5m8.apps.googleusercontent.com

# Control-plane base URL. It is also the fallback used for account deletion before pairing.
EXPO_PUBLIC_PASS_RELAY_URL=https://remote.pass.lightsoft.dev
