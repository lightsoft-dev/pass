{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pass-mobile-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],

  // The dashboard is a static Worker Asset served on the same origin as the
  // control plane, so browser calls do not need permissive CORS headers.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Values are configured with Workers Secrets or a local .dev.vars file.
  // Declaring only the name keeps credentials out of source control and lets
  // `wrangler types` generate the binding type.
  "secrets": {
    "required": [
      "RELAY_AUTH_TOKEN",
      "DEVICE_CREDENTIAL_PEPPER",
      "APPLE_PRIVATE_KEY",
      "APPLE_TOKEN_ENCRYPTION_KEY",
      "NOTION_API_TOKEN",
      "NOTION_FEEDBACK_DATA_SOURCE_ID"
    ]
  },

  // The deployed worker is still the developer environment. Production must
  // set this to false after every client has moved to device credentials.
  "vars": {
    "ALLOW_DEVELOPMENT_AUTH": "true"
  },

  // Production is a separate Worker, Durable Object namespace, D1 database, and rate-limit
  // namespace. OAuth client identifiers are public deployment variables; credential peppers and
  // third-party service credentials remain Wrangler secrets.
  "env": {
    "production": {
      "secrets": {
        "required": [
          "DEVICE_CREDENTIAL_PEPPER",
          "APPLE_PRIVATE_KEY",
          "APPLE_TOKEN_ENCRYPTION_KEY"
        ]
      },
      "vars": {
        "ALLOW_DEVELOPMENT_AUTH": "false",
        "GOOGLE_CLIENT_ID": "181273138649-6t8qq9nubb5be8ckob8jnme6ptlk705q.apps.googleusercontent.com",
        "OIDC_AUDIENCE": "181273138649-6t8qq9nubb5be8ckob8jnme6ptlk705q.apps.googleusercontent.com",
        "OIDC_ISSUER": "https://accounts.google.com",
        "OIDC_JWKS_URL": "https://www.googleapis.com/oauth2/v3/certs",
        "APPLE_OIDC_ISSUER": "https://appleid.apple.com",
        "APPLE_OIDC_AUDIENCE": "dev.lightsoft.passmobile",
        "APPLE_OIDC_JWKS_URL": "https://appleid.apple.com/auth/keys",
        "APPLE_TEAM_ID": "H66C2M66DC",
        "APPLE_CLIENT_ID": "dev.lightsoft.passmobile",
        "APPLE_KEY_ID": "6U7WLG7GPJ"
      },
      "routes": [
        {
          "pattern": "remote.pass.lightsoft.dev",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "pass-mobile-control-prod",
          "database_id": "a3ded58e-d4ec-487f-a113-cf898e4600e6",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "24101",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "PAIRING_RATE_LIMITER",
          "namespace_id": "24102",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "FEEDBACK_RATE_LIMITER",
          "namespace_id": "24103",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DESKTOP_ROOMS",
            "class_name": "DesktopRoom"
          }
        ]
      }
    }
  },

  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "pass-mobile-control-dev",
      "database_id": "4ed8ae87-a928-476a-810e-19422e3f6163",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "24001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PAIRING_RATE_LIMITER",
      "namespace_id": "24002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "24003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DESKTOP_ROOMS",
        "class_name": "DesktopRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DesktopRoom"]
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
